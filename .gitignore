.DS_Store

# Local run output and the visualizer environment.
demo-output/
tools/visualize_run/.venv/

# Machine-local Codex config. It contains absolute paths for this checkout.
# Regenerate with: tools/print-codex-config.sh > .codex/config.toml
.codex/config.toml

# The received handoff package: its source, contracts, docs and tests are tracked so a
# clone is runnable. The original ZIP and the unrelated mechanical supplement stay local.
# Keys and run records are excluded by the rules at the bottom.
handover-review/*.zip
handover-review/supplement/

# Caches, environments, keys, and run records, including any path re-included above.
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/config/local.json
**/data/
**/data-mcp/
**/*.egg-info/
**/.pytest_cache/
.DS_Store
